# Copy to backend/.env and fill in. Never commit .env.
PORT=8787
HOST=0.0.0.0
# DB_PATH=./data/pocket.db
# Set to 0 to disable /api/dev/* evaluation routes
DEV_ROUTES=1

# Any OpenAI-compatible chat-completions endpoint with tool calling.
# Default: Google Gemini (free tier available at https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=replace-me
LLM_TIMEOUT_MS=20000
# Optional. For Gemini 2.5 Flash, 'low' (or 'none') cuts latency; leave empty for providers that don't support it.
LLM_REASONING_EFFORT=low

# Alternatives (uncomment one block):
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Local Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
