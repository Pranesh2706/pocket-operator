{
  "expo": {
    "name": "Pocket Operator",
    "slug": "pocket-operator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pocketoperator.demo",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Pocket Operator converts your spoken request into text.",
        "NSMicrophoneUsageDescription": "Pocket Operator uses the microphone only while you hold the talk button, to turn your request into text."
      }
    },
    "android": {
      "package": "com.pocketoperator.demo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E4F0E3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pocket Operator uses the microphone only while you hold the talk button, to turn your request into text.",
          "speechRecognitionPermission": "Pocket Operator converts your spoken request into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b37df039-44a9-4429-98ca-0892af9d5938"
      }
    },
    "owner": "praneshdev"
  }
}
